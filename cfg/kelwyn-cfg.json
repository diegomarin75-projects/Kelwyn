{
  
  //File paths
  "history_file": ".kelwyn_history",
  "debug_log_file": ".kelwyn_debug.log",
  
  //Alias definitions
  "aliases":{
    "dir":{"enabled":true,"command":"ls -v"}
  },
  
  //System prompt
  "system_prompt":"{%94m%}<user>@<hostname>{%0m%}<beta> {%92m%}<cwd>{%0m%}<git> {%90m%}>{%0m%} ",
  
  //Sizes
  "max_debug_lines":5000,
  "max_history_commands":25000,
  "completer_maximun_height_percent":40,
  "command_box_maximun_height_percent":40,

  //Git info timeout (seconds)
  "git_info_timeout_secs":10,

  //ASCII banner
  "ascii_banner":"ASCII_BANNER1",

  //Key bindings
  "key_bindings":{
    "UP"               : "prev_history_command",
    "DOWN"             : "next_history_command",
    "ALT+RIGHT"        : "suggestion_by_prefix",
    "ALT+SHIFT+RIGHT"  : "suggestion_by_wildcard",
    "TAB"              : "complete_token",
    "LEFT"             : "move_left",
    "RIGHT"            : "move_right",
    "CTRL+LEFT"        : "move_word_left",
    "CTRL+RIGHT"       : "move_word_right",
    "HOME"             : "move_home",
    "END"              : "move_end",
    "SHIFT+LEFT"       : "move_left_select",
    "SHIFT+RIGHT"      : "move_right_select",
    "CTRL+SHIFT+LEFT"  : "move_word_left_select",
    "CTRL+SHIFT+RIGHT" : "move_word_right_select",
    "SHIFT+HOME"       : "move_home_select",
    "SHIFT+END"        : "move_end_select",
    "ALT+UP"           : "show_prev_suggestion",
    "ALT+DOWN"         : "show_next_suggestion",
    "BACKSPACE"        : "move_back",
    "DELETE"           : "delete_position",
    "ESCAPE"           : "prompt_clear",
    "CTRL+C"           : "selection_copy",
    "CTRL+D"           : "terminate_shell",
    "RETURN"           : "execute_command"
  }, 

  //Color theme
  "color_theme":"default_ansi",

  //Color themes
  "color_themes": {

    "default_rgb":{
      "error_message_color"                :"#FF0000",
      "ghost_suggestion_color"             :"#505050",
      "selection_foreground_color"         :"#FFFF00",
      "selection_background_color"         :"#0000FF",
      "completer_option_highlight_color"   :"#303030",
      "completer_option_background_color"  :null,
      "completer_status_foreground_color"  :"#909090",
      "completer_status_background_color"  :"#303030",
      "command_box_item_foreground_color"  :"#7F7F7F",
      "command_box_item_highlight_color"   :"#0000C0",
      "command_box_item_background_color"  :"#202020",
      "command_box_status_foreground_color":"#C0C0C0",
      "command_box_status_background_color":"#A00000",
      "global_dir_color"                   :"#40B0FF",
      "global_file_color"                  :"#7F7F7F",
      "global_file_error_color"            :"#FF0000",
      "global_dir_header_color"            :"#FF7F7F",
      "git_clean_color"                    :"#FF5555",
      "git_dirty_color"                    :"#FF50FF",
      "git_conflict_color"                 :"#FFFF00",
      "git_branch_color"                   :"#909090",
      "stable_mode_color"                  :"#007F00",
      "beta_mode_color"                    :"#00FFFF",
      "option_error_color"                 :"#FF0000"
    },

    "default_ansi":{
      "error_message_color"                :"bright_red",
      "ghost_suggestion_color"             :"bright_black",
      "selection_foreground_color"         :"bright_yellow",
      "selection_background_color"         :"bright_blue",
      "completer_option_highlight_color"   :"bright_black",
      "completer_option_background_color"  :null,
      "completer_status_foreground_color"  :"bright_whitek",
      "completer_status_background_color"  :"bright_black",
      "command_box_item_foreground_color"  :"dark_white",
      "command_box_item_highlight_color"   :"dark_blue",
      "command_box_item_background_color"  :"bright_black",
      "command_box_status_foreground_color":"bright_white",
      "command_box_status_background_color":"bright_red",
      "global_dir_color"                   :"bright_cyan",
      "global_file_color"                  :"dark_white",
      "global_file_error_color"            :"bright_red",
      "global_dir_header_color"            :"bright_red",
      "git_clean_color"                    :"bright_red",
      "git_dirty_color"                    :"bright_magenta",
      "git_conflict_color"                 :"bright_yellow",
      "git_branch_color"                   :"bright_black",
      "stable_mode_color"                  :"dark_green",
      "beta_mode_color"                    :"bright_cyan",
      "option_error_color"                 :"bright_red"
    }

  }

}