#!/usr/bin/env bash
#
# NOTE: This hook only runs when core.hooksPath points to this directory.
# Enable it with:  git config core.hooksPath .githooks
# (Otherwise Git looks in .git/hooks/ and ignores this script.)
#
set -euo pipefail

VERSION_FILE="VERSION"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "pre-commit: $VERSION_FILE not found" >&2
  exit 1
fi

current="$(tr -d '[:space:]' < "$VERSION_FILE")"

if [[ ! "$current" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "pre-commit: invalid version '$current' in $VERSION_FILE (expected X.Y.Z)" >&2
  exit 1
fi

major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"
patch="${BASH_REMATCH[3]}"

patch=$((patch + 1))
if ((patch > 50)); then
  patch=0
  minor=$((minor + 1))
  if ((minor > 50)); then
    minor=0
    major=$((major + 1))
  fi
fi

printf '%s.%s.%s\n' "$major" "$minor" "$patch" > "$VERSION_FILE"
git add "$VERSION_FILE"

echo "pre-commit: version bumped to ${major}.${minor}.${patch}"
